{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 21808,
      "protocol": "socks",
      "tag": "socks-in",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "ip": "127.0.0.1"
      }
    },
    {
      "listen": "127.0.0.1",
      "port": 21809,
      "protocol": "http",
      "tag": "http-in",
      "settings": {
        "allowTransparent": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "address": "104.18.1.1",
            "port": 443,
            "password": "humanity"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "www.ignitelimit.com",
          "alpn": [
            "http/1.1"
          ],
          "fingerprint": "chrome"
        },
        "wsSettings": {
          "path": "/assignment",
          "host": "www.ignitelimit.com",
          "headers": {
            "Host": "www.ignitelimit.com"
          }
        },
        "finalmask": {
          "tcp": [
            {
              "type": "fragment",
              "settings": {
                "packets": "tlshello",
                "lengths": [
                  "5"
                ],
                "delays": [
                  "0"
                ],
                "maxSplit": "2"
              }
            }
          ]
        },
        "sockopt": {
          "domainStrategy": "UseIPv4",
          "tcpKeepAliveInterval": 1,
          "tcpKeepAliveIdle": 11,
          "interface": "Ethernet"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": []
  }
}